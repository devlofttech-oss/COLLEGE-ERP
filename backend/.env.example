# ─────────────────────────────────────────────────────────────
# College ERP Backend — environment variables
# Copy to `.env` for local development (never commit `.env`).
# On Vercel, set these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of frontend origins allowed to call this API
# (web app dev + deployed URLs). Needed for cookies to work cross-site.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# ── Firebase Auth (client-side sign-in REST call) ──
# The public Web API key from Firebase console → Project settings → General.
# Used only to verify email/password via Identity Toolkit.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ── Firebase Admin SDK (server) ──
# Service account credentials. Two ways to provide them:
#   1. Paste the whole service-account JSON as one line here (recommended for Vercel):
FIREBASE_SERVICE_ACCOUNT=
#   2. OR, for local dev, drop the file at backend/serviceAccountKey.json (gitignored)
#      and leave FIREBASE_SERVICE_ACCOUNT empty.

# Session cookie lifetime in days (Firebase max is 14)
SESSION_COOKIE_DAYS=5

# ── Cloudflare R2 (object storage for documents + images) ──
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=college-erp-media
# Public base URL for images (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
